    "Practical guidance for the situations that actually come up off-grid — not a first-aid manual, just what to do next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practical guidance for the situations that actually come up off-grid — not a first-aid manual, just what to do next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía práctica para las situaciones que realmente surgen fuera de la red — no es un manual de primeros auxilios, solo qué hacer a continuación."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Практичні поради на випадки, які реально трапляються поза цивілізацією — не підручник із першої допомоги, а просто що робити далі."
          }
        }
      }
    },
    "Precise location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise location"
          }
        },
        "es": {
