        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación en segundo plano mantiene tu recorrido en vivo y la baliza SOS precisos mientras el teléfono está en tu bolsillo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
