          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дикі тварини знайшли ваш табір або їжу"
          }
        }
      }
    },
    "You both unlock early access to the next region we open up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You both unlock early access to the next region we open up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos desbloquean acceso anticipado a la próxima región que abramos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви обидва отримаєте ранній доступ до наступного регіону."
          }
        }
      }
    },
    "You can browse without either. Navigation stays locked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can browse without either. Navigation stays locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes explorar sin ninguno de los dos. La navegación seguirá bloqueada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш переглядати без цього. Навігація лишиться заблокованою."
          }
        }
      }
    },
    "You can edit every detail — gear, grade, segments — before it goes live.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can edit every detail — gear, grade, segments — before it goes live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes editar cada detalle — equipo, dificultad, tramos — antes de publicarlo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш відредагувати кожну деталь — спорядження, складність, сегменти — перед публікацією."
          }
        }
      }
    },
    "You're Pro.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres Pro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти в Pro."
          }
        }
      }
    },
    "You're browsing without an account — routes you like or save stick around, but nothing syncs to another device and there's no name to show here yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're browsing without an account — routes you like or save stick around, but nothing syncs to another device and there's no name to show here yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás navegando sin una cuenta — las rutas que te gusten o guardes se conservan, pero nada se sincroniza con otro dispositivo y aún no hay un nombre que mostrar aquí."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти переглядаєш без акаунту — вподобані чи збережені маршрути лишаться, але нічого не синхронізується на інші пристрої, і поки немає імені для показу тут."
          }
        }
      }
    },
    "You're overdue and someone should be worried": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're overdue and someone should be worried"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con retraso y alguien debería estar preocupado"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви запізнюєтесь, і хтось має хвилюватись"
          }
        }
      }
    },
    "You've lost the trail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've lost the trail"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has perdido el sendero"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви загубили стежку"
          }
        }
      }
    },
    "Your code — they get 15 points on sign-up, you get 30 once they enter it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your code — they get 15 points on sign-up, you get 30 once they enter it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu código — ellos reciben 15 puntos al registrarse, tú recibes 30 cuando lo usan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш код — вони отримують 15 балів при реєстрації, ви — 30, коли вони його введуть."
          }
        }
      }
    },
    "Your last known position, route name and battery level to your emergency contacts and local rescue where covered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last known position, route name and battery level to your emergency contacts and local rescue where covered."
