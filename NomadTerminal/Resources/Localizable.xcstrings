    },
    "Widen distance or drop a requirement to see more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widen distance or drop a requirement to see more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
