    "Tap anywhere on the globe — any country, any spot on Earth. Numbered photo pins already show where routes exist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap anywhere on the globe — any country, any spot on Earth. Numbered photo pins already show where routes exist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier punto del globo — cualquier país, cualquier lugar de la Tierra. Los marcadores numerados ya muestran dónde existen rutas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись будь-де на глобусі — будь-яка країна, будь-яка точка Землі. Нумеровані фотопозначки вже показують, де є маршрути."
          }
        }
      }
    },
