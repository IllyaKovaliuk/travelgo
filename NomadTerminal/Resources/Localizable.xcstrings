        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta un track desde Garmin Connect, Strava, AllTrails, Komoot o cualquier app que guarde un archivo GPX o KML."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортуй трек із Garmin Connect, Strava, AllTrails, Komoot чи будь-якого застосунку, що зберігає GPX або KML."
          }
        }
      }
    },
