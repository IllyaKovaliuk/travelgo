    "Loss of coordination at altitude is a medical emergency, not a \"let's slow down\" situation. Descend now — don't wait for it to pass.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loss of coordination at altitude is a medical emergency, not a \"let's slow down\" situation. Descend now — don't wait for it to pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de coordinación en altitud es una emergencia médica, no una situación de \"vamos más despacio\". Desciende ya — no esperes a que se te pase."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Втрата координації на висоті — це медична надзвичайна ситуація, а не привід просто «сповільнитись». Спускайтесь негайно — не чекайте, поки минеться само."
          }
        }
      }
    },
