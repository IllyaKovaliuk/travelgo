        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última posición conocida, el nombre de la ruta y el nivel de batería a tus contactos de emergencia y al rescate local donde esté disponible."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя остання відома позиція, назва маршруту й рівень заряду — контактам для екстрених випадків і місцевим рятувальникам, де це доступно."
          }
        }
      }
