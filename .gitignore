# macOS
.DS_Store

# Xcode — project.pbxproj and Info.plist are generated by `xcodegen generate`
# from NomadTerminal/project.yml (the actual source of truth), so the
# .xcodeproj itself and Generated/ are build artifacts, not source.
NomadTerminal/NomadTerminal.xcodeproj/
NomadTerminal/Generated/
xcuserdata/
*.xcuserstate
DerivedData/

# Secrets — never commit these (see backend/.env for the real one).
backend/.env
backend/.env.*
backend/supabase/.temp/
backend/supabase/.branches/
